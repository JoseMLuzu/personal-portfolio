# Backend only. Never expose this value through Vite variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=12

# Public frontend link. This is not a secret.
VITE_GITHUB_URL=https://github.com/JoseMLuzu

# Comma-separated frontend origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:5173
PORTFOLIO_URL=http://localhost:5173

# Basic in-memory request limit per IP.
BITTY_RATE_LIMIT=12
BITTY_RATE_WINDOW_SECONDS=60
